        "pythonCode": "rows = [item[\"json\"] for item in _items]\n\ndef uniq(key):\n    return sorted({r.get(key) for r in rows if r.get(key) is not None})\n\ndef one_or_many(values):\n    return values[0] if len(values) == 1 else values\n\ndef date_only(value):\n    return value[:10] if value else None\n\ndates = sorted({date_only(r.get(\"date\")) for r in rows if r.get(\"date\")})\nbudgets = [float(r[\"daily_budget\"]) for r in rows if r.get(\"daily_budget\") is not None]\n\nentity = {\n    \"type\": \"campaign\",\n    \"id\": one_or_many(uniq(\"campaign_id\")),\n    \"name\": one_or_many(uniq(\"campaign_name\")),\n    \"market\": one_or_many(uniq(\"market\")),\n    \"daily_budget\": round(sum(budgets) / len(budgets), 2) if budgets else None,\n    \"products\": uniq(\"asin\"),\n    \"keywords\": uniq(\"keyword_target\"),\n    \"days_amount\": len(dates),\n    \"date_range\": {\n        \"min_date\": dates[0] if dates else None,\n        \"max_date\": dates[-1] if dates else None,\n    },\n}\n\nreturn [{\"json\": {\"entity\": entity}}]"
